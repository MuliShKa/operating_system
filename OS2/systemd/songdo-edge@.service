[Unit]
Description=Songdo OS2 Robot Edge Controller (%i)
After=local-fs.target
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/operating_system/OS2
Environment=PYTHONPATH=src
ExecStart=%h/operating_system/OS2/.venv/bin/python -m edge.supervisor
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=8
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/operating_system/OS2/data /tmp/songdo-os2

[Install]
WantedBy=default.target
